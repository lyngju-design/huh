-- TSB Auto Tech Script (Updated with Oreo, Supa, Kiba, K1ng, and Reflex)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Map these to your RedHubGuiScript toggles
local Settings = {
    WalkSpeed = 16,
    NoDashCooldown = false,
    AutoTech_KittyDash = false,
    InstantLethal = false,
    
    -- New Techs
    OreoTech = false,
    SupaTech = false,
    KibaTech = false,
    K1ngTech = false,
    ReflexTech = false,
    
    -- Configs
    TechDistance = 4,
    ReflexRange = 15
}

-- Bypass Dash Cooldown
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if Settings.NoDashCooldown and method == "FireServer" and tostring(self) == "Dash" then
        return
    end
    
    return oldNamecall(self, ...)
end)

-- Utility: Get closest enemy for Reflex Tech
local function getClosestEnemy()
    local closestDist = math.huge
    local closestTarget = nil
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestTarget = v.Character
            end
        end
    end
    return closestTarget, closestDist
end

-- Core Tech Mechanics Loop
RunService.Heartbeat:Connect(function(deltaTime)
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hum = char.Humanoid
    local hrp = char.HumanoidRootPart

    -- Constant Walkspeed Override
    if Settings.WalkSpeed > 16 then
        hum.WalkSpeed = Settings.WalkSpeed
    end

    -- [REFLEX TECH] Auto-dodge/block when an enemy gets too close and is moving towards you fast
    if Settings.ReflexTech then
        local enemy, dist = getClosestEnemy()
        if enemy and dist <= Settings.ReflexRange then
            local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
            if enemyHRP and enemyHRP.AssemblyLinearVelocity.Magnitude > 25 then
                -- Automatically snap out of the way (simulated perfect dodge)
                hrp.CFrame = hrp.CFrame * CFrame.new(-5, 0, 0)
            end
        end
    end

    -- Trigger Techs on Dash (Q Key)
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then 
        
        -- Kitty Dash
        if Settings.AutoTech_KittyDash then
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -Settings.TechDistance)
        end
        
        -- Oreo Tech (Sidestep Momentum Shift)
        if Settings.OreoTech then
            -- Snaps character diagonally to bypass frontal hitboxes
            hrp.CFrame = hrp.CFrame * CFrame.new(-3, 0, -3)
        end

        -- Supa Tech (Vertical/Diagonal Uppercut Setup)
        if Settings.SupaTech then
            -- Pops the player slightly up and forward for mid-air combo catching
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 1.5, -4)
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 30, hrp.AssemblyLinearVelocity.Z)
        end

        -- K1ng Tech (Aggressive Forward Snap + Camera Lock adjustment)
        if Settings.K1ngTech then
            local enemy, dist = getClosestEnemy()
            if enemy and dist < 20 then
                -- Warps directly to the enemy's blind spot
                local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
                if enemyHRP then
                    hrp.CFrame = enemyHRP.CFrame * CFrame.new(2, 0, 2)
                end
            end
        end

        -- Kiba Tech (Rapid Back-and-Forth Dash)
        if Settings.KibaTech then
            -- Fakes a forward dash but snaps backward slightly to bait attacks
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
            task.wait(0.05)
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -5)
        end
    end

    -- Instant/Boomy Lethal Simulation
    if Settings.InstantLethal then
        local target = mouse.Target
        if target and target.Parent:FindFirstChild("Humanoid") then
            local enemyHRP = target.Parent:FindFirstChild("HumanoidRootPart")
            if enemyHRP then
                hrp.CFrame = enemyHRP.CFrame * CFrame.new(0, 0, 3) 
            end
        end
    end
end)
