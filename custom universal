-- Toast Notification System
local function sendNotification(message)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 260, 0, 40)
    notif.Position = UDim2.new(1, 10, 0.85, 0)
    notif.BackgroundColor3 = currentTheme.TopBar
    notif.BorderSizePixel = 0
    addCorner(notif, 8)
    notif.Parent = ScreenGui
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = message
    text.TextColor3 = currentTheme.Text
    text.Font = Enum.Font.SourceSansBold
    text.TextSize = 14
    text.Parent = notif
    
    notif:TweenPosition(UDim2.new(1, -275, 0.85, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
    task.delay(2.5, function()
        notif:TweenPosition(UDim2.new(1, 10, 0.85, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true, function()
            notif:Destroy()
        end)
    end)
end

-- Helper Functions
local function createInputRow(placeholder, btnText, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 36)
    row.BackgroundTransparency = 1
    
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.65, -4, 1, 0)
    input.Position = UDim2.new(0, 0, 0, 0)
    input.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    input.TextColor3 = Color3.fromRGB(240, 240, 240)
    input.PlaceholderText = placeholder
    input.PlaceholderColor3 = Color3.fromRGB(130, 130, 145)
    input.Text = ""
    input.Font = Enum.Font.SourceSans
    input.TextSize = 14
    addCorner(input, 6)
    input.Parent = row
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.35, -4, 1, 0)
    btn.Position = UDim2.new(0.65, 4, 0, 0)
    btn.BackgroundColor3 = currentTheme.Button
    btn.TextColor3 = currentTheme.Text
    btn.Text = btnText
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    addCorner(btn, 6)
    btn.Parent = row
    
    btn.MouseButton1Click:Connect(function()
        callback(input.Text)
    end)
    
    row.Parent = scroll
    return row
end

local function createToggle(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 36)
    btn.BackgroundColor3 = currentTheme.Button
    btn.TextColor3 = currentTheme.Text
    btn.Text = text .. ": OFF"
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    addCorner(btn, 6)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(35, 130, 70) or currentTheme.Button
        callback(state)
    end)
    
    btn.Parent = scroll
    return btn
end

