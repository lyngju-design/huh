local function playTrack(name, assetId)
    local id = tostring(assetId)
    -- Strip everything except numbers to ensure clean formatting
    local rawId = string.match(id, "%d+") 
    if rawId then
        broadcastSound.SoundId = "rbxassetid://" .. rawId
        broadcastSound:Play()
        trackTitle.Text = name
        trackStatus.Text = "Broadcasting..."
    end
end

stopBtn.MouseButton1Click:Connect(function()
    broadcastSound:Stop()
    trackTitle.Text = "No track playing"
    trackStatus.Text = "Stopped"
end)

local function renderLibrary()
    for _, child in ipairs(tracksContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for i, track in ipairs(savedTracks) do
        local trackFrame = Instance.new("Frame")
        trackFrame.Size = UDim2.new(1, 0, 0, 45)
        trackFrame.BackgroundColor3 = theme.Surface
        applyCorner(trackFrame, 6)
        
        local playBtn = Instance.new("TextButton")
        playBtn.Size = UDim2.new(1, -40, 1, 0)
        playBtn.BackgroundTransparency = 1
        playBtn.Text = "  " .. track.name
        playBtn.TextColor3 = theme.Text
        playBtn.Font = Enum.Font.GothamMedium
        playBtn.TextSize = 13
        playBtn.TextXAlignment = Enum.TextXAlignment.Left
        playBtn.Parent = trackFrame
        
        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Size = UDim2.new(0, 30, 0, 30)
        deleteBtn.Position = UDim2.new(1, -38, 0, 7.5)
        deleteBtn.BackgroundColor3 = theme.Background
        deleteBtn.Text = "🗑"
        deleteBtn.TextColor3 = theme.TextMuted
        deleteBtn.Font = Enum.Font.Gotham
        deleteBtn.TextSize = 12
        applyCorner(deleteBtn, 6)
        deleteBtn.Parent = trackFrame
        
        -- Hover Effects
        trackFrame.MouseEnter:Connect(function() createTween(trackFrame, {BackgroundColor3 = theme.SurfaceLight}):Play() end)
        trackFrame.MouseLeave:Connect(function() createTween(trackFrame, {BackgroundColor3 = theme.Surface}):Play() end)
        
        deleteBtn.MouseEnter:Connect(function() createTween(deleteBtn, {BackgroundColor3 = theme.Danger, TextColor3 = theme.Text}):Play() end)
        deleteBtn.MouseLeave:Connect(function() createTween(deleteBtn, {BackgroundColor3 = theme.Background, TextColor3 = theme.TextMuted}):Play() end)
        
        playBtn.MouseButton1Click:Connect(function()
            playTrack(track.name, track.id)
        end)
        
        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(savedTracks, i)
            saveTracksToFile()
            renderLibrary()
        end)
        
        trackFrame.Parent = tracksContainer
    end
end

saveBtn.MouseButton1Click:Connect(function()
    local tName = nameInput.Text
    local tId = idInput.Text
    if tName ~= "" and tId ~= "" then
        table.insert(savedTracks, {name = tName, id = tId})
        nameInput.Text = ""
        idInput.Text = ""
        saveTracksToFile()
        renderLibrary()
    end
end)

renderLibrary()
