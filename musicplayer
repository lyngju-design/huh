-- ==========================================
-- FILE SAVING & LOADING LOGIC
-- ==========================================
local savedTracks = {}

local function loadTracks()
    if isfile and readfile and isfile(SAVE_FILE) then
        local readSuccess, data = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end)
        if readSuccess and type(data) == "table" then
            return data
        end
    end
    -- Default tracks if no save file exists
    return {
        {name = "Lo-Fi Chill Beats", id = "1848354536"},
        {name = "Synthwave Neon", id = "1837840135"}
    }
end

local function saveTracksToFile()
    if writefile then
        local writeSuccess, data = pcall(function()
            return HttpService:JSONEncode(savedTracks)
        end)
        if writeSuccess then
            writefile(SAVE_FILE, data)
        end
    end
end

savedTracks = loadTracks()

