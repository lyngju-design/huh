-- Functions
local function playTrack(name, assetId)
    local id = tostring(assetId)
    if not string.match(id, "rbxassetid://") then
        id = "rbxassetid://" .. id
    end
    
    broadcastSound.SoundId = id
    broadcastSound:Play()
    
    trackTitle.Text = name
    trackStatus.Text = "Broadcasting to server..."
end

local function renderTracksList()
    for _, child in ipairs(tracksContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, track in ipairs(savedTracks) do
        local trackBtn = Instance.new("TextButton")
        trackBtn.Size = UDim2.new(1, 0, 0, 42)
        trackBtn.BackgroundColor3 = theme.Surface
        trackBtn.TextColor3 = theme.TextWhite
        trackBtn.Text = "   ▶  " .. track.name
        trackBtn.Font = Enum.Font.GothamBold
        trackBtn.TextSize = 13
        trackBtn.TextXAlignment = Enum.TextXAlignment.Left
        addCorner(trackBtn, 8)
        
        -- Hover effects
        trackBtn.MouseEnter:Connect(function()
            trackBtn.BackgroundColor3 = theme.Highlight
        end)
        trackBtn.MouseLeave:Connect(function()
            trackBtn.BackgroundColor3 = theme.Surface
        end)
        
        trackBtn.MouseButton1Click:Connect(function()
            playTrack(track.name, track.id)
        end)
        
        trackBtn.Parent = tracksContainer
    end
end

saveBtn.MouseButton1Click:Connect(function()
    local nameText = nameInput.Text
    local idText = idInput.Text
    
    if nameText ~= "" and idText ~= "" then
        table.insert(savedTracks, {name = nameText, id = idText})
        nameInput.Text = ""
        idInput.Text = ""
        renderTracksList()
    end
end)

-- Initial Render
renderTracksList()
